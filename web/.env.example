# OpenAI API key. Keep this server-side; never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional. Default: gpt-6-astra
OPENAI_MODEL=gpt-6-astra

# Shared access gate for this private, single-owner studio.
STUDIO_ACCESS_PASSWORD=

# At least 32 random characters. Generate with Node:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
